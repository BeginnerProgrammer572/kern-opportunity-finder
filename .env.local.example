# Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore, so it never gets committed or pushed publicly.

# Supabase project settings (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic API key - keep this secret, server-side only, never exposed to the browser
ANTHROPIC_API_KEY=your-anthropic-api-key
